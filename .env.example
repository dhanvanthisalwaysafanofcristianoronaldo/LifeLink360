# Copy this file to .env, then replace the placeholders with your MongoDB Atlas details.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lifelink360
API_PORT=4000
# Public website origin for deployment, without a trailing slash.
FRONTEND_ORIGIN=
# Hosted API URL used by the Vite frontend build; leave blank for local development.
VITE_API_BASE_URL=
